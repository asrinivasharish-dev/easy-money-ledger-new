rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLoan(data, userId) {
      return data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.personName is string && data.personName.size() >= 1 && data.personName.size() <= 200
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.transactionType in ['GIVEN', 'TAKEN']
        && data.interestType in ['NO_INTEREST', 'SIMPLE_INTEREST']
        && data.interestFrequency in ['MONTHLY', 'YEARLY']
        && data.interestRate is number && data.interestRate >= 0 && data.interestRate <= 1000
        && data.startDate is string && data.startDate.size() <= 30
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 30))
        && (!('hasIndefiniteDueDate' in data) || data.hasIndefiniteDueDate is bool)
        && (!('mobileNumber' in data) || (data.mobileNumber is string && data.mobileNumber.size() <= 30))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('paymentMedium' in data) || (data.paymentMedium is string && data.paymentMedium.size() <= 40))
        && (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 100))
        && (!('additionalCredits' in data) || (data.additionalCredits is list && data.additionalCredits.size() <= 500))
        && (!('repayments' in data) || (data.repayments is list && data.repayments.size() <= 500));
    }

    // User Private Profile & Settings
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // User Personal Loans Ledger
      match /loans/{loanId} {
        allow read, delete: if isOwner(userId) && isValidId(loanId);
        allow create, update: if isOwner(userId) && isValidId(loanId) && isValidLoan(incoming(), userId);
      }
    }
  }
}
